// Phase 5: batch upload, the upload queue, Live ID.
test "a batch uploads one observation per placed photo"
  at "/account"
  epoch "2026-11-09T23:00:00Z"
  clock data
  type "handle" "naturalist.test"
  tap "sign-in"
  authorize
  clock data
  tap "tab-home"
  clock data
  tap "home-batch"
  clock settle
  tap "batch-add"
  pick "batch-photos" "fixtures/photo-with-exif.jpg"
  clock data
  tap "batch-add"
  pick "batch-photos" "assets/photos/oak.png"
  clock data
  expect text "batch-missing" == "1 photo has no place and won’t upload."
  expect text "batch-upload" == "Upload 1"
  tap "batch-use-0"
  expect text "batch-title-0" == "Eastern Newt · Notophthalmus viridescens"
  tap "batch-remove-1"
  expect tree missing "batch-missing"
  tap "batch-upload"
  clock data
  clock settle
  expect text "sent-note" == "1 observation uploaded."
  expect tree missing "pending"

test "offline, a batch waits in the queue, survives a relaunch and uploads later"
  at "/account"
  epoch "2026-11-09T23:00:00Z"
  clock data
  type "handle" "naturalist.test"
  tap "sign-in"
  authorize
  clock data
  tap "tab-home"
  clock data
  tap "home-batch"
  clock settle
  tap "batch-add"
  pick "batch-photos" "fixtures/photo-with-exif.jpg"
  clock data
  fail fetch "http://127.0.0.1:8787/api/occurrences"
  tap "batch-upload"
  clock data
  clock settle
  expect text "queued-0" == "Unidentified"
  expect text "queued-status-0" == "Waiting"
  expect text "send-note" == "You’re offline. These upload when you’re back."
  reload
  clock data
  expect text "queued-0" == "Unidentified"
  pass fetch "http://127.0.0.1:8787/api/occurrences"
  tap "send-now"
  clock data
  expect text "sent-note" == "1 observation uploaded."
  expect tree missing "pending"

// Live ID's camera is a held device request under Exact's test driver, which a
// test can't answer, so only the way in is tested here.
test "signed out, Live ID and Batch Upload open Account instead"
  epoch "2026-11-09T23:00:00Z"
  clock data
  tap "tab-home"
  clock data
  tap "home-live"
  clock settle
  expect tree has "handle"
  tap "tab-home"
  tap "home-batch"
  clock settle
  expect tree has "handle"

// Phase 6: iNaturalist, against server.ts's fake (it approves at once).
test "an iNaturalist account links, sets cross-posting, and unlinks after asking"
  at "/account"
  epoch "2026-11-09T23:00:00Z"
  clock data
  type "handle" "naturalist.test"
  tap "sign-in"
  authorize
  clock data
  expect text "inat-note" == "Post your observations to iNaturalist too."
  tap "inat-link"
  authorize
  clock data
  expect text "inat-login" == "@naturalist_on_inat"
  expect disabled "inat-require-photos"
  tap "inat-crosspost"
  clock data
  expect state inat.crosspost == true
  expect enabled "inat-require-photos"
  tap "inat-unlink"
  clock settle
  tap "unlink-confirm"
  clock data
  expect tree has "inat-link"
  expect tree missing "inat-login"

test "with cross-posting on, a new observation goes to iNaturalist too"
  at "/account"
  epoch "2026-11-09T23:00:00Z"
  clock data
  type "handle" "naturalist.test"
  tap "sign-in"
  authorize
  clock data
  tap "inat-link"
  authorize
  clock data
  tap "inat-crosspost"
  clock data
  tap "tab-home"
  clock data
  tap "home-new-observation"
  clock settle
  expect state newCrosspost == true
  tap "new-place-on-map"
  tap "new-save"
  clock data
  clock settle
  expect text "crosspost-status" == "Posting to iNaturalist…"

test "one of your observations can be posted to iNaturalist"
  at "/account"
  epoch "2026-11-09T23:00:00Z"
  clock data
  type "handle" "naturalist.test"
  tap "sign-in"
  authorize
  clock data
  tap "inat-link"
  authorize
  clock data
  tap "tab-explore"
  clock data
  tap "obs-3mzvx3lfxlr22"
  clock data
  clock settle
  expect text "crosspost-status" == "Not on iNaturalist yet."
  tap "crosspost-post"
  clock data
  expect text "crosspost-status" == "Posting to iNaturalist…"
  expect tree missing "crosspost-post"

// Phase 7: polish.
test "the welcome card shows on a first visit until it's dismissed, then never again"
  epoch "2026-11-09T23:00:00Z"
  clock data
  expect tree has "welcome"
  tap "welcome-dismiss"
  expect tree missing "welcome"
  reload
  clock data
  expect tree missing "welcome"
  expect text "obs-title-3mzucjhpluy22" == "Common Loon"

test "the welcome card's Sign In opens Account"
  epoch "2026-11-09T23:00:00Z"
  clock data
  tap "welcome-sign-in"
  clock settle
  expect tree has "handle"

test "offline, a banner says so, and Try Again recovers"
  fail fetch "http://127.0.0.1:8787/api/feeds/explore"
  epoch "2026-11-09T23:00:00Z"
  clock data
  expect tree has "offline-banner"
  pass fetch "http://127.0.0.1:8787/api/feeds/explore"
  tap "offline-retry"
  clock data
  expect tree missing "offline-banner"
  expect text "obs-title-3mzucjhpluy22" == "Common Loon"

test "a profile lists the person's identifications too"
  epoch "2026-11-09T23:00:00Z"
  clock data
  tap "obs-3mzucjhpluy22"
