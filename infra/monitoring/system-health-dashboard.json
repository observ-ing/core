        "widget": {
          "title": "CPU p99 by service (fraction of limit)",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "minAlignmentPeriod": "60s",
                "timeSeriesQuery": {
                  "prometheusQuery": "histogram_quantile(0.99, sum by (service_name, le) (rate(run_googleapis_com:container_cpu_utilizations_bucket{monitored_resource=\"cloud_run_revision\"}[5m])))"
