      {
        "xPos": 0,
        "yPos": 10,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "tap-ingester: firehose bytes received per second",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "minAlignmentPeriod": "60s",
                "timeSeriesQuery": {
                  "prometheusQuery": "sum(rate(run_googleapis_com:container_network_received_bytes_count{monitored_resource=\"cloud_run_revision\",service_name=\"tap-ingester\"}[5m]))"
                }
              }
            ],
            "yAxis": { "label": "bytes/s", "scale": "LINEAR" }
          }
        }
      },
      {
        "xPos": 6,
        "yPos": 10,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "observing-appview: requests per second by status class",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "STACKED_AREA",
                "targetAxis": "Y1",
                "minAlignmentPeriod": "60s",
                "timeSeriesQuery": {
                  "prometheusQuery": "sum by (response_code_class) (rate(run_googleapis_com:request_count{monitored_resource=\"cloud_run_revision\",service_name=\"observing-appview\"}[5m]))"
                }
              }
            ],
            "yAxis": { "label": "requests/s", "scale": "LINEAR" }
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 14,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "observing-db: CPU (fraction of 1 vCPU)",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "minAlignmentPeriod": "60s",
                "timeSeriesQuery": {
                  "prometheusQuery": "max(cloudsql_googleapis_com:database_cpu_utilization{monitored_resource=\"cloudsql_database\",database_id=\"observ-ing:observing-db\"})"
                }
              }
            ],
            "thresholds": [
              { "label": "80%", "value": 0.8, "color": "YELLOW", "direction": "ABOVE", "targetAxis": "Y1" }
            ],
            "yAxis": { "label": "fraction of limit", "scale": "LINEAR" }
          }
        }
      },
      {
        "xPos": 6,
        "yPos": 14,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "observing-db: memory used vs limit (bytes)",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "minAlignmentPeriod": "60s",
                "legendTemplate": "used",
                "timeSeriesQuery": {
                  "prometheusQuery": "max(cloudsql_googleapis_com:database_memory_total_usage{monitored_resource=\"cloudsql_database\",database_id=\"observ-ing:observing-db\"})"
                }
              },
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "minAlignmentPeriod": "60s",
                "legendTemplate": "limit",
                "timeSeriesQuery": {
                  "prometheusQuery": "max(cloudsql_googleapis_com:database_memory_quota{monitored_resource=\"cloudsql_database\",database_id=\"observ-ing:observing-db\"})"
                }
              }
            ],
            "yAxis": { "label": "bytes", "scale": "LINEAR" }
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 18,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "observing-db: open connections by database",
          "xyChart": {
