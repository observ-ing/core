{
  "displayName": "System Health",
  "mosaicLayout": {
    "columns": 12,
    "tiles": [
      {
        "xPos": 0,
        "yPos": 0,
        "width": 12,
        "height": 2,
        "widget": {
          "title": "How to read this",
          "text": {
            "format": "MARKDOWN",
            "content": "Resource use for each Cloud Run service and for observing-db (Cloud SQL). Cloud Run reports memory and CPU as a fraction of the container's limit (1.0 = 100%). Limits are set in `.github/workflows/ci.yml`; tap-ingester runs with 1 vCPU and 512 MiB. Percentiles come from Cloud Run's histogram buckets, so low values move in steps of about 1%. **tap-ingester firehose bytes received** is its liveness signal: it should sit around 2 MB/s, and a drop to 0 means the firehose consumer has stalled. Instance counts and up/down live on the Service Status dashboard. This dashboard's source is `infra/monitoring/system-health-dashboard.json`."
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 2,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "tap-ingester: memory (fraction of limit)",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "minAlignmentPeriod": "60s",
                "legendTemplate": "p99",
                "timeSeriesQuery": {
                  "prometheusQuery": "histogram_quantile(0.99, sum by (le) (rate(run_googleapis_com:container_memory_utilizations_bucket{monitored_resource=\"cloud_run_revision\",service_name=\"tap-ingester\"}[5m])))"
                }
              },
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "minAlignmentPeriod": "60s",
                "legendTemplate": "p50",
                "timeSeriesQuery": {
                  "prometheusQuery": "histogram_quantile(0.50, sum by (le) (rate(run_googleapis_com:container_memory_utilizations_bucket{monitored_resource=\"cloud_run_revision\",service_name=\"tap-ingester\"}[5m])))"
                }
              }
            ],
            "thresholds": [
              { "label": "80%", "value": 0.8, "color": "YELLOW", "direction": "ABOVE", "targetAxis": "Y1" }
            ],
            "yAxis": { "label": "fraction of limit", "scale": "LINEAR" }
          }
        }
      },
      {
        "xPos": 6,
        "yPos": 2,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "tap-ingester: CPU (fraction of 1 vCPU)",
          "xyChart": {
