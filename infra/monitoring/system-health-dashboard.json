                "plotType": "STACKED_AREA",
                "targetAxis": "Y1",
                "minAlignmentPeriod": "60s",
                "timeSeriesQuery": {
                  "prometheusQuery": "sum by (database) (cloudsql_googleapis_com:database_postgresql_num_backends{monitored_resource=\"cloudsql_database\",database_id=\"observ-ing:observing-db\",database!~\"template.*|postgres\"})"
                }
              }
            ],
            "yAxis": { "label": "connections", "scale": "LINEAR" }
          }
        }
      },
      {
        "xPos": 6,
