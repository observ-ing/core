                "minAlignmentPeriod": "60s",
                "legendTemplate": "p99",
                "timeSeriesQuery": {
                  "prometheusQuery": "histogram_quantile(0.99, sum by (le) (rate(run_googleapis_com:container_cpu_utilizations_bucket{monitored_resource=\"cloud_run_revision\",service_name=\"tap-ingester\"}[5m])))"
                }
              },
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "minAlignmentPeriod": "60s",
                "legendTemplate": "p50",
                "timeSeriesQuery": {
                  "prometheusQuery": "histogram_quantile(0.50, sum by (le) (rate(run_googleapis_com:container_cpu_utilizations_bucket{monitored_resource=\"cloud_run_revision\",service_name=\"tap-ingester\"}[5m])))"
                }
              }
            ],
            "thresholds": [
              { "label": "80%", "value": 0.8, "color": "YELLOW", "direction": "ABOVE", "targetAxis": "Y1" }
            ],
            "yAxis": { "label": "fraction of limit", "scale": "LINEAR" }
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 6,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Memory p99 by service (fraction of limit)",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "minAlignmentPeriod": "60s",
                "timeSeriesQuery": {
                  "prometheusQuery": "histogram_quantile(0.99, sum by (service_name, le) (rate(run_googleapis_com:container_memory_utilizations_bucket{monitored_resource=\"cloud_run_revision\"}[5m])))"
                }
              }
            ],
            "thresholds": [
              { "label": "80%", "value": 0.8, "color": "YELLOW", "direction": "ABOVE", "targetAxis": "Y1" }
