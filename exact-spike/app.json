{
  "$schema": "../../../../../../../src/exact/scripts/app.schema.json",
  "name": "Observ.ing",
  "short_name": "Observ.ing",
  "id": "ing.observ.exactspike",
  "start_url": "/",
  "display": "standalone",
  "app": {
    "id": "ing.observ.exactspike",
    "name": "Observ.ing"
  },
  "host": {
    "web": {},
    "linux": {},
    "ios": {
      "associatedDomains": [
        "applinks:observ.ing"
      ]
    }
  },
  "deploy": {
    "store": {
      "web": "0",
      "linux": "0"
    }
  },
  "commands": {
    "server": [
      "bun",
      "server.ts"
    ]
  },
  "packages": {
    "@exact/maps": {
      "web": {
        "tiles": "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
        "attribution": "© OpenStreetMap contributors",
        "maxZoom": 19
      }
    }
  },
  "env": [
    "OBSERVING_AUTH_ORIGIN"
  ]
}
