// Against fixtures/explore.json, recorded from observ.ing by record.ts.
test "the feed shows the first page and pushes a detail"
  epoch "2026-11-09T23:00:00Z"
  time-zone "America/Los_Angeles"
  clock data
  expect text "title-3mzvx3lfxlr22" == "Unidentified"
  expect text "title-4wnkwnbb5h4xk" == "Western Pygmy-Blue"
  tap "obs-4wnkwnbb5h4xk"
  clock data
  expect text "detail-title" == "Western Pygmy-Blue"
  expect text "detail-sci" == "Brephidium exilis"
  expect text "detail-lineage" == "Animalia › Arthropoda › Insecta › Lepidoptera › Lycaenidae › Brephidium"

test "an unidentified observation asks for an identification"
  epoch "2026-11-09T23:00:00Z"
  clock data
  tap "obs-3mzvx3lfxlr22"
  clock data
  expect text "detail-title" == "Unidentified"
  expect text "needs-id" == "Needs an identification"

test "Show More asks for the next page"
  epoch "2026-11-09T23:00:00Z"
  clock data
  tap "more"
  clock data
  expect text "title-3mzucjgh2r522" == "Common Murre"
